# Backend API URL
VITE_API_URL=http://localhost:8000

# Use mock backend (true=mockデータ使用, false=実際のバックエンド使用)
# 本番環境では必ずfalseに設定してください
VITE_USE_MOCK=false

# Database connection
VITE_DB_URL=postgresql://cqox_user:cqox_pass@localhost:5432/cqox_db

# Monitoring
VITE_ENABLE_MONITORING=true
VITE_SENTRY_DSN=

# Feature flags
VITE_ENABLE_EXPERIMENTS=true
VITE_ENABLE_POLICIES=true
VITE_ENABLE_ANALYTICS=true
