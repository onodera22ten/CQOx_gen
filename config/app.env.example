# CQOx Application Configuration
# Copy this file to .env and update with your actual values

# Environment: local|staging|prod
APP_ENV=local

# Application Settings
APP_NAME=CQOx
APP_VERSION=1.0.0
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://cqox:cqox_dev_password@postgres:5432/cqox_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# Celery Configuration
CELERY_BROKER_URL=amqp://cqox:cqox_dev_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=7200

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Account (for initial setup)
ADMIN_EMAIL=admin@cqox.local
ADMIN_PASSWORD=admin_password_change_me

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/cqox_backend.jsonl

# File Upload
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=csv,parquet,json

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Feature Flags
ENABLE_MULTI_TENANCY=false
ENABLE_OAUTH=false
ENABLE_WEBSOCKETS=false
